# -----------------------------------------------------------------------------
# Open Innings — environment variables (example)
# -----------------------------------------------------------------------------
# Copy this file to .env.local and fill in real values.
#
# Required for v0.1:
#   1. Create a Supabase project at https://supabase.com/dashboard
#   2. Settings → API → copy "Project URL" and "anon public" key
#   3. Settings → Database → Connection string → copy the "Transaction" pooler URI
# -----------------------------------------------------------------------------

# Public — exposed to the browser. SAFE to be public.
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Server-only — never exposed to the browser. KEEP SECRET.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Direct DB connection for Drizzle (migrations). Use the "Transaction" pooler
# from Supabase → Settings → Database → Connection string.
DATABASE_URL="postgresql://postgres.your-ref:your-password@aws-0-us-east-1.pooler.supabase.com:6543/postgres"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
