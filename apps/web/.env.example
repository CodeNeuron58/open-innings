# -----------------------------------------------------------------------------
# Open Innings — environment variables (example)
# -----------------------------------------------------------------------------
# Copy this file to .env.local and fill in real values.
#
# Quickstart (local dev):
#   1. cp .env.example .env.local
#   2. pnpm db:migrate
#   3. pnpm db:seed
#   4. pnpm dev
# -----------------------------------------------------------------------------

# Direct Postgres connection (used by Drizzle for queries AND migrations).
# Default assumes a local Postgres with user=postgres, password=postgres,
# and a database called "open_innings" (create it with:
#   psql -U postgres -h localhost -c "create database open_innings;")
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/open_innings"

# Secret used to sign session cookies. Generate a real one for production:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="dev-only-change-me-before-production-please-use-32-bytes-min"

# Public app URL (used in emails, share links). Localhost is fine for dev.
NEXT_PUBLIC_APP_URL="http://localhost:3000"