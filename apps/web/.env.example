# -----------------------------------------------------------------------------
# Open Innings — environment variables (example)
# -----------------------------------------------------------------------------
# Copy this file to .env.local and fill in real values.
#
# Quickstart (local dev):
#   1. cp .env.example .env.local
#   2. pnpm db:migrate
#   3. pnpm db:seed
#   4. pnpm dev
# -----------------------------------------------------------------------------

# Direct Postgres connection (used by Drizzle for queries AND migrations).
# No pooler — this connects straight to Postgres, self-hosted or otherwise.
# Default assumes a local Postgres with user=postgres, password=postgres,
# and a database called "open_innings" (create it with:
#   psql -U postgres -h localhost -c "create database open_innings;")
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/open_innings"

# Connecting to a managed Postgres (Heroku, a cloud VM)? TLS is negotiated
# automatically for any non-localhost host — see lib/db/ssl.ts. You do not need
# to append ?sslmode=require, and appending it to a Heroku DATABASE_URL would
# not survive anyway: Heroku rewrites that variable on credential rotation.

# Where this site is served from. Used for absolute URLs in metadata — most
# visibly the share-card images a link preview loads.
#
# Read at RUNTIME, so changing it on a deployed app takes effect on restart.
# Prefer this over NEXT_PUBLIC_APP_URL, which Next inlines at build time and
# which therefore keeps serving the old value until the next rebuild — a
# change that appears to do nothing.
APP_URL="http://localhost:3000"

# Legacy name for the same thing. Still honoured, build-time only.
# NEXT_PUBLIC_APP_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# Mail — Resend
# -----------------------------------------------------------------------------
# Required for anything that sends a credential: the six-digit signup code and
# the password-reset link.
#
# Leaving these unset does NOT disable those flows. Codes and tokens are still
# issued, and `lib/mail/send.ts` returns `not_configured` — so an account can
# be created that nobody can confirm, and a reset can be requested that never
# arrives. In development the message body is printed to the console so you can
# read the code; in production it deliberately is not, because that would put a
# live credential in the log drain.
RESEND_API_KEY=""

# The From address. Must be on a domain verified in Resend, or Resend rejects
# the message and the console shows the rejection rather than a delivery.
MAIL_FROM="Open Innings <noreply@localhost>"

# -----------------------------------------------------------------------------
# Android app links
# -----------------------------------------------------------------------------
# SHA-256 certificate fingerprints, comma-separated, served at
# /.well-known/assetlinks.json so Android can verify that openinnings.com and
# the app belong to each other.
#
# Unset, the route returns 404 by design — an empty fingerprint list reads to
# Android as "no app is associated with this site", which is worse than no file
# at all. Deep links simply fall back to the browser until it is set.
#
# Take the value from **Play App Signing**, not from the local keystore: Google
# re-signs the upload, so the fingerprint that matters only exists after the
# first release.
# ANDROID_CERT_SHA256=""

# -----------------------------------------------------------------------------
# Optional
# -----------------------------------------------------------------------------
# Where `pnpm smoke:api` points. Defaults to http://localhost:3000.
# SMOKE_BASE_URL="http://localhost:3000"

# How many proxies in front of the app can be trusted to have appended an
# honest entry to x-forwarded-for. One on Heroku (its router), which is the
# default — raise it only if you add a CDN, and count the hops exactly. Too
# many and a client can forge its own rate-limit key again.
# TRUSTED_PROXY_HOPS="1"

# Ceiling on the Postgres connection pool. Default 10.
#
# A ceiling, not a reservation — idle connections are handed back. Heroku
# Essential allows about twenty in total, so two dynos at 10 each is the whole
# allowance, leaving nothing for the release phase or `heroku pg:psql`. Set it
# here rather than in code so scaling out is not a deploy.
# DATABASE_POOL_MAX="10"

# -----------------------------------------------------------------------------
# Escape hatches for the destructive scripts. Leave unset.
# -----------------------------------------------------------------------------
# `db:reset` refuses a database whose name is not recognisably this project's,
# because a localhost port-forward to production looks local to a host check.
# `db:seed` refuses a non-local host outright, because it creates an account
# whose password is published in this repository.
#
# Both print the variable that overrides them when they refuse. They are
# documented here so the refusal is not the first you hear of them — not
# because you should set them.
# OI_RESET_ANY_DB="1"
# OI_SEED_REMOTE="1"
