{
  "expo": {
    "name": "Open Innings",
    "slug": "open-innings",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "openinnings",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "app.openinnings",
      "adaptiveIcon": {
        "backgroundColor": "#0F2A20"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-8954748975838698~4371071953"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ad94ee2d-b6e3-4aac-a6eb-761c8d698f15"
      }
    },
    "owner": "biprayanc"
  }
}
