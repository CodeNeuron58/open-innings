{
  "expo": {
    "name": "Open Innings",
    "slug": "open-innings",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "openinnings",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "android": {
      "package": "app.openinnings",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1d2d3d"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "openinnings.com",
              "pathPrefix": "/m"
            },
            {
              "scheme": "https",
              "host": "openinnings.com",
              "pathPrefix": "/p"
            },
            {
              "scheme": "https",
              "host": "openinnings.com",
              "pathPrefix": "/c"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-8954748975838698~4371071953"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#1d2d3d",
          "imageWidth": 180
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ad94ee2d-b6e3-4aac-a6eb-761c8d698f15"
      }
    },
    "owner": "biprayanc"
  }
}
