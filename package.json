{
  "name": "open-innings",
  "version": "0.1.0",
  "private": true,
  "description": "Free, open-source, forever cricket scoring app. Like Lichess for cricket.",
  "license": "AGPL-3.0",
  "homepage": "https://github.com/CodeNeuron58/open-innings",
  "repository": {
    "type": "git",
    "url": "https://github.com/CodeNeuron58/open-innings.git"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.12.0",
  "pnpm": {
    "overrides": {
      "react-dom": "19.2.3"
    }
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "start": "pnpm --filter web start",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "smoke:score": "pnpm --filter web smoke:score",
    "smoke:p1": "pnpm --filter web smoke:p1",
    "db:migrate": "pnpm --filter web db:migrate",
    "db:backup": "pnpm --filter web db:backup",
    "db:verify": "pnpm --filter web db:verify",
    "db:seed": "pnpm --filter web db:seed",
    "db:reset": "pnpm --filter web db:reset",
    "db:studio": "pnpm --filter web db:studio",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json,yml,yaml}\"",
    "smoke:api": "pnpm --filter web smoke:api",
    "smoke:browse": "pnpm --filter web smoke:browse",
    "smoke:correct": "pnpm --filter web smoke:correct",
    "smoke:xi": "pnpm --filter web smoke:xi",
    "smoke:auth": "pnpm --filter web smoke:auth"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "eslint": "^9",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.8",
    "turbo": "^2.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8"
  }
}
